{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "errorscript:build:dev",
      "type": "shell",
      "command": "mise",
      "args": [":build:dev"],
      "options": { "cwd": "${workspaceFolder}/subs/errs-vscode/extensions/typescript-language-features" },
      "problemMatcher": ["$rustc", "$tsc"],
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "errorscript:package",
      "type": "shell",
      "command": "mise",
      "args": [":build/package"],
      "options": { "cwd": "${workspaceFolder}/subs/errs-vscode/extensions/typescript-language-features" },
      "problemMatcher": ["$rustc", "$tsc"]
    }
  ]
}
